# Server
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/collab-code-editor

# Judge0 API (sandboxed code execution)
# Sign up for a free key at https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# AI Debugging (OpenAI-compatible endpoint, e.g. OpenAI, Groq, or local LLM)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your_openai_key_here
AI_MODEL=gpt-4o-mini
